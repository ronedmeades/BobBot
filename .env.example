# ============================================
# Bob — Essential Configuration
# ============================================
# Tip: Run "pnpm setup" to create this file interactively!

# Pick your AI provider: anthropic, openai, or gemini
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# Provider defaults (if LLM_MODEL is blank):
#   gemini    → gemini-2.0-flash       (free tier available)
#   openai    → gpt-4o-mini            (~$0.15 per million tokens)
#   anthropic → claude-sonnet-4-5-20250929 (~$3 per million tokens)

# Your name — how Bob will address you
OWNER_NAME=Owner

# ============================================
# Optional — Bob can help you set these up
# ============================================

# Telegram (chat with Bob from your phone)
# Ask Bob: "Help me set up Telegram"
# TELEGRAM_BOT_TOKEN=
# OWNER_USER_ID=

# Dashboard API token (secures all /api/* endpoints)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOB_API_TOKEN=

# Dashboard port (default: 3000)
# DASHBOARD_PORT=3000

# Backup (path to external drive or backup directory)
# BACKUP_PATH=
# BACKUP_INTERVAL_DAYS=3

# Legacy — still works if LLM_API_KEY is not set
# ANTHROPIC_API_KEY=

# eBay API (needed for listing skills)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REFRESH_TOKEN=
# EBAY_ENVIRONMENT=sandbox

# Gmail API (needed for email skills)
# See: https://developers.google.com/gmail/api/quickstart/nodejs
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Etsy API (needed for Etsy marketplace features)
# See: https://developers.etsy.com/documentation/
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=
# ETSY_REFRESH_TOKEN=
# ETSY_SHOP_ID=

# Twilio (phone calls & SMS)
# Sign up at twilio.com, get a phone number (~$1.15/mo), then set these:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+15551234567
# OWNER_PHONE_NUMBER=+15559876543
