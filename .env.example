# LLM Provider — pick one: anthropic, openai, or gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Provider-specific defaults (if LLM_MODEL is blank):
#   anthropic → claude-sonnet-4-5-20250929
#   openai    → gpt-4o-mini
#   gemini    → gemini-2.0-flash

# Legacy — still works if LLM_API_KEY is not set
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Examples for other providers:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-xxxxx
#
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy-xxxxx

TELEGRAM_BOT_TOKEN=123456:ABC-DEF
OWNER_USER_ID=your-telegram-user-id
OWNER_NAME=YourName
OWNER_NOTES=Optional notes about the owner for Bob's memory

# Backup (optional — path to external drive or backup directory)
BACKUP_PATH=
BACKUP_INTERVAL_DAYS=3

# eBay API (optional — needed for listing skills)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENVIRONMENT=sandbox

# Gmail API (optional — needed for email skills)
# See: https://developers.google.com/gmail/api/quickstart/nodejs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
