{
  "name": "bob",
  "version": "0.1.0",
  "description": "Bob - Autonomous AI personal agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "shortcut:remove": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1 -Uninstall"
  },
  "keywords": [
    "ai",
    "agent",
    "telegram",
    "autonomous"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "edge-tts": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "fingerprint-generator": "^2.1.80",
    "fingerprint-injector": "^2.1.80",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.39.3",
    "openai": "^6.18.0",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
